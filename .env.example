# Required API Keys



# Embedding Configuration (Optional - defaults provided)
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_MAX_RETRIES=3

# Chunking Configuration (Optional - defaults provided)
# MIN_CHUNK_TOKENS=100
# MAX_CHUNK_TOKENS=500
# OVERLAP_TOKENS=50

# Retrieval Configuration (Optional - defaults provided)
# INITIAL_RETRIEVAL_COUNT=10
# FINAL_RESULT_COUNT=5

# Vector Store Configuration (Optional - defaults provided)
# CHROMA_PERSIST_DIR=./chroma_data
# VECTORSTORE_MAX_RETRIES=3

# LLM Configuration (Optional - defaults provided)
# LLM_MODEL_NAME=llama-3.1-8b-instant
# LLM_MAX_TOKENS=2048
# LLM_TEMPERATURE=0.7
# LLM_STREAM=true

# Conversation Configuration (Optional - defaults provided)
# MAX_HISTORY_MESSAGES=10

# Performance Configuration (Optional - defaults provided)
# QUERY_TIMEOUT_SECONDS=10
# INDEXING_TIMEOUT_MINUTES=30
